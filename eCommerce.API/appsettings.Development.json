{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MongoDbSettings": {
    "ConnectionString": "mongodb://$DB_HOST:$DB_PORT",
    "DatabaseName": "$DB_NAME",
    "OrdersCollectionName": "Orders"
  },
  "UsersMicroservice": {
    "RetryCount": 4,
    "RetryBackoffBase": 2,
    "BreakingThreshold": 3,
    "BreakDuration": 60,
    "Timeout": 100,
    "MaxParallelization": 10,
    "MaxQueuingActions": 20
  },
  "ProductsMicroservice": {
    "RetryCount": 4,
    "RetryBackoffBase": 2,
    "BreakingThreshold": 3,
    "BreakDuration": 60,
    "Timeout": 100,
    "MaxParallelization": 10,
    "MaxQueuingActions": 20
  }
}
